FROM python:3.12.15-slim-bookworm
ARG TRADE_BOT_RELEASE
WORKDIR /opt/trade-bot
COPY pyproject.toml README.md requirements-runtime.lock requirements-build.lock requirements-dev.lock ./
COPY app ./app
RUN pip install --no-deps --no-cache-dir -r requirements-build.lock -r requirements-dev.lock \
    && pip install --no-deps --no-build-isolation --no-cache-dir . \
    && pip check
COPY tests ./tests
COPY scripts ./scripts
COPY examples ./examples
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 TRADER_LIVE_ENABLED=false
LABEL trade-bot.offline-soak.release=$TRADE_BOT_RELEASE
ENTRYPOINT ["python", "-I", "-W", "error", "/opt/trade-bot/scripts/paper-soak.py"]
