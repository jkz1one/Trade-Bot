TRADER_MODE=PAPER
TRADER_STARTING_CAPITAL=10.00
TRADER_DB_URL=sqlite:///./trader.db
TRADER_LIVE_ENABLED=false
TRADER_MODEL_NAME=gpt-5.6-luna
TRADER_MODEL_INPUT_USD_PER_MILLION=0.20
TRADER_MODEL_OUTPUT_USD_PER_MILLION=1.20

# Slice 2 Robinhood MCP (OAuth tokens are stored outside the repo by default)
TRADER_ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
TRADER_ROBINHOOD_REDIRECT_URI=http://127.0.0.1:8765/callback
TRADER_ROBINHOOD_OAUTH_STORAGE=~/.trade-bot/robinhood-oauth.json
TRADER_ROBINHOOD_SCHEMA_SNAPSHOT=var/robinhood-tool-schemas.json
