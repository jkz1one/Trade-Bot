FROM python:3.12-slim
ARG TRADE_BOT_RELEASE=unknown
WORKDIR /opt/trade-bot
COPY pyproject.toml README.md ./
COPY app ./app
RUN pip install --no-cache-dir . \
    && groupadd --gid 10001 tradebot \
    && useradd --uid 10001 --gid tradebot --no-log-init --create-home tradebot
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 XDG_CACHE_HOME=/tmp/.cache
ENV TRADER_RELEASE_SHA=$TRADE_BOT_RELEASE
USER 10001:10001
CMD ["python", "-m", "app.robinhood.cli", "shadow-service"]
